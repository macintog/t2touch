# SPDX-License-Identifier: GPL-2.0-only
[Unit]
Description=Apple T2 Touch ID authentication daemon
Documentation=file:/opt/t2-touchid/README.md
Requires=t2-native-first-run.service t2-biometric-ready.service t2-touchid-post-reboot.service
After=dbus.service network.target t2-native-first-run.service t2-biometric-ready.service t2-touchid-post-reboot.service

[Service]
Type=dbus
BusName=net.reactivated.Fprint
EnvironmentFile=/etc/t2-touchid.conf
ExecStart=/opt/t2-touchid/.venv/bin/python /opt/t2-touchid/src/t2-fprintd.py --enable-native-enrollment --enable-native-deletion
Restart=on-failure
RestartSec=2
UMask=0077
RuntimeDirectory=t2-touchid/workers
RuntimeDirectoryMode=0700
ReadWritePaths=/run/t2-touchid /var/lib/t2-touchid

ProtectSystem=strict
# The installer binds only the configured account home back into this empty
# namespace, read-only, so account-recreation evidence remains live.
ProtectHome=tmpfs
PrivateTmp=true
NoNewPrivileges=true
ProtectKernelTunables=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectKernelModules=true
ProtectHostname=true
# Caller authorization pins non-root PAM clients through D-Bus ProcessFD and
# revalidates their /proc identity. Hiding other users here makes every
# unprivileged lock-screen and direct fprintd client look as though it exited.
ProtectProc=default
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
# runuser needs SETGID/SETUID. Caller liveness uses poll(2) on its D-Bus
# ProcessFD, and Polkit helpers are bound to their exact systemd cgroup, so
# caller validation does not need CAP_KILL or CAP_SYS_PTRACE.
# RestrictSUIDSGID stays off.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_IPC_LOCK CAP_SETGID CAP_SETUID CAP_SYS_ADMIN
SystemCallArchitectures=native
DevicePolicy=closed
DeviceAllow=/dev/t2-aks rw
DeviceAllow=/dev/t2-acm rw
DeviceAllow=/dev/null rw
DeviceAllow=/dev/urandom r
RestrictAddressFamilies=AF_UNIX AF_LOCAL AF_NETLINK AF_INET6
MemoryDenyWriteExecute=true
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
