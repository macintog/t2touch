[Unit]
Description=Apple T2 SEP transport for Touch ID
After=local-fs.target t2-biometric-port-refresh.service
ConditionPathExists=/usr/local/sbin/t2-sep-transport-load

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/t2-sep-transport-load
ExecStop=/usr/local/sbin/t2-sep-transport-unload
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
