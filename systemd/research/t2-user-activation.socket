# SPDX-License-Identifier: GPL-2.0-only
[Unit]
Description=Apple T2 native user activation socket
Documentation=file:/opt/t2-touchid/README.md

[Socket]
ListenSequentialPacket=/run/t2-touchid/activation.sock
Accept=yes
SocketMode=0660
DirectoryMode=0700
RemoveOnStop=yes
MaxConnections=16
MaxConnectionsPerSource=1

[Install]
WantedBy=sockets.target
