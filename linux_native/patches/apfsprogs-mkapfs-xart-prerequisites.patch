+static void add_record(struct apfs_kvloc **next_toc, void *key_area,
+		       void **key, int key_len, void *val_area_end,
+		       void **val_end, int val_len)
+{
+	struct apfs_kvloc *kvloc = *next_toc;
+
+	kvloc->k.off = cpu_to_le16(*key - key_area);
+	kvloc->k.len = cpu_to_le16(key_len);
+	*key += key_len;
+	kvloc->v.off = cpu_to_le16(val_area_end - *val_end + val_len);
+	kvloc->v.len = cpu_to_le16(val_len);
+	*val_end -= val_len;
+	++*next_toc;
+}
+
+void make_seed_file_dentry(struct apfs_kvloc **next_toc,
+			   void *key_area, void **key,
+			   void *val_area_end, void **val_end)
+{
+	struct apfs_drec_val *val;
+	int key_len = make_special_dentry_key(APFS_ROOT_DIR_INO_NUM,
+						param->seed_name, *key);
+	int val_len = sizeof(*val);
+
+	val = *val_end - val_len;
+	val->file_id = cpu_to_le64(APFS_MIN_USER_INO_NUM);
+	val->date_added = cpu_to_le64(get_timestamp());
+	val->flags = cpu_to_le16(S_IFREG >> 12);
+	add_record(next_toc, key_area, key, key_len,
+		   val_area_end, val_end, val_len);
+}
+
+void make_seed_file_inode(struct apfs_kvloc **next_toc,
+			  void *key_area, void **key,
+			  void *val_area_end, void **val_end)
+{
+	struct apfs_inode_val *val;
+	struct apfs_xf_blob *xblob;
+	struct apfs_x_field *xfield;
+	struct apfs_dstream *dstream;
+	int name_len = strlen(param->seed_name) + 1;
+	int padded_name_len = ROUND_UP(name_len, 8);
+	int values_len = padded_name_len + sizeof(*dstream);
+	int val_len = sizeof(*val) + sizeof(*xblob) +
+		      2 * sizeof(*xfield) + values_len;
+	int key_len = make_special_inode_key(APFS_MIN_USER_INO_NUM, *key);
+	char *value;
+
+	val = *val_end - val_len;
+	val->parent_id = cpu_to_le64(APFS_ROOT_DIR_INO_NUM);
+	val->private_id = cpu_to_le64(APFS_MIN_USER_INO_NUM);
+	val->create_time = val->mod_time = val->change_time =
+		val->access_time = cpu_to_le64(get_timestamp());
+	val->nlink = cpu_to_le32(1);
+	val->default_protection_class = cpu_to_le32(APFS_PROTECTION_CLASS_D);
+	val->owner = 0;
+	val->group = 0;
+	val->mode = cpu_to_le16(0600 | S_IFREG);
+
+	xblob = (struct apfs_xf_blob *)val->xfields;
+	xblob->xf_num_exts = cpu_to_le16(2);
+	xblob->xf_used_data = cpu_to_le16(values_len);
+	xfield = (struct apfs_x_field *)xblob->xf_data;
+	xfield[0].x_type = APFS_INO_EXT_TYPE_NAME;
+	xfield[0].x_flags = APFS_XF_DO_NOT_COPY;
+	xfield[0].x_size = cpu_to_le16(name_len);
+	xfield[1].x_type = APFS_INO_EXT_TYPE_DSTREAM;
+	xfield[1].x_flags = APFS_XF_SYSTEM_FIELD;
+	xfield[1].x_size = cpu_to_le16(sizeof(*dstream));
+
+	value = (char *)&xfield[2];
+	strcpy(value, param->seed_name);
+	value += padded_name_len;
+	dstream = (struct apfs_dstream *)value;
+	dstream->size = cpu_to_le64(param->seed_size);
+	dstream->alloced_size = cpu_to_le64(param->seed_size);
+
+	add_record(next_toc, key_area, key, key_len,
+		   val_area_end, val_end, val_len);
+}
+
+void make_seed_dstream_record(struct apfs_kvloc **next_toc,
+			      void *key_area, void **key,
+			      void *val_area_end, void **val_end)
+{
+	struct apfs_dstream_id_key *dkey = *key;
+	struct apfs_dstream_id_val *val;
+	int key_len, val_len = sizeof(*val);
+
+	set_key_header(APFS_MIN_USER_INO_NUM, APFS_TYPE_DSTREAM_ID, &dkey->hdr);
+	key_len = sizeof(*dkey);
+	val = *val_end - val_len;
+	val->refcnt = cpu_to_le32(1);
+	add_record(next_toc, key_area, key, key_len,
+		   val_area_end, val_end, val_len);
+}
+
+void make_seed_extent_record(struct apfs_kvloc **next_toc,
+			     void *key_area, void **key,
+			     void *val_area_end, void **val_end)
+{
+	struct apfs_file_extent_key *ekey = *key;
+	struct apfs_file_extent_val *val;
+	int key_len, val_len = sizeof(*val);
+
+	set_key_header(APFS_MIN_USER_INO_NUM, APFS_TYPE_FILE_EXTENT, &ekey->hdr);
+	ekey->logical_addr = 0;
+	key_len = sizeof(*ekey);
+	val = *val_end - val_len;
+	val->len_and_flags = cpu_to_le64(param->seed_size);
+	val->phys_block_num = cpu_to_le64(seed_data_bno);
+	val->crypto_id = 0;
+	add_record(next_toc, key_area, key, key_len,
+		   val_area_end, val_end, val_len);
+}
+
