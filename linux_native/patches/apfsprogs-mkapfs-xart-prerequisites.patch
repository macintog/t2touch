+void make_seed_extref_root(u64 bno, u64 oid)
+{
+	struct apfs_btree_node_phys *root = get_zeroed_block();
+	struct apfs_btree_info *info;
+	struct apfs_kvloc *kvloc;
+	struct apfs_phys_ext_key *key;
+	struct apfs_phys_ext_val *val;
+	int head_len = sizeof(*root);
+	int info_len = sizeof(*info);
+	int toc_len = min_table_size(APFS_OBJECT_TYPE_BLOCKREFTREE);
+	int key_len = sizeof(*key), val_len = sizeof(*val), free_len;
+
+	root->btn_flags = cpu_to_le16(APFS_BTNODE_ROOT | APFS_BTNODE_LEAF);
+	root->btn_nkeys = cpu_to_le32(1);
+	root->btn_table_space.off = 0;
+	root->btn_table_space.len = cpu_to_le16(toc_len);
+	kvloc = (void *)root + head_len;
+	key = (void *)root + head_len + toc_len;
+	val = (void *)root + param->blocksize - info_len - val_len;
+	kvloc->k.off = 0;
+	kvloc->k.len = cpu_to_le16(key_len);
+	kvloc->v.off = cpu_to_le16(val_len);
+	kvloc->v.len = cpu_to_le16(val_len);
+	key->hdr.obj_id_and_type = cpu_to_le64(
+		((u64)APFS_TYPE_EXTENT << APFS_OBJ_TYPE_SHIFT) | seed_data_bno);
+	val->len_and_kind = cpu_to_le64(
+		((u64)APFS_KIND_NEW << APFS_PEXT_KIND_SHIFT) |
+		(param->seed_size / param->blocksize));
+	val->owning_obj_id = cpu_to_le64(APFS_MIN_USER_INO_NUM);
+	val->refcnt = cpu_to_le32(1);
+	free_len = param->blocksize - head_len - toc_len - key_len - val_len - info_len;
+	root->btn_free_space.off = cpu_to_le16(key_len);
+	root->btn_free_space.len = cpu_to_le16(free_len);
+	root->btn_key_free_list.off = cpu_to_le16(APFS_BTOFF_INVALID);
+	root->btn_val_free_list.off = cpu_to_le16(APFS_BTOFF_INVALID);
+	info = (void *)root + param->blocksize - info_len;
+	info->bt_fixed.bt_flags = cpu_to_le32(APFS_BTREE_PHYSICAL |
+					      APFS_BTREE_KV_NONALIGNED);
+	info->bt_fixed.bt_node_size = cpu_to_le32(param->blocksize);
+	info->bt_longest_key = cpu_to_le32(key_len);
+	info->bt_longest_val = cpu_to_le32(val_len);
+	info->bt_key_count = cpu_to_le64(1);
+	info->bt_node_count = cpu_to_le64(1);
+	set_object_header(&root->btn_o, param->blocksize, oid,
+			  APFS_OBJECT_TYPE_BTREE | APFS_OBJ_PHYSICAL,
+			  APFS_OBJECT_TYPE_BLOCKREFTREE);
+	apfs_writeall(root, 1, bno);
+}
