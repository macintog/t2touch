+/**
+ * parse_volume_role - Parse a numeric APFS volume role
+ * @string: role in decimal, octal or hexadecimal notation
+ */
+static u16 parse_volume_role(const char *string)
+{
+	unsigned long role;
+	char *end;
+
+	role = strtoul(string, &end, 0);
+	if (end == string || *end || role > UINT16_MAX)
+		fatal("invalid volume role");
+	return role;
+}
+
+static void parse_seed_file(char *string)
+{
+	char *separator, *end;
+	char *cursor;
+	unsigned long long size;
+
+	separator = strrchr(string, ':');
+	if (!separator || separator == string || !separator[1])
+		fatal("invalid seed file (expected name:size)");
+	*separator = 0;
+	if (strchr(string, '/') || strlen(string) > APFS_NAME_LEN)
+		fatal("invalid seed file name");
+	for (cursor = string; *cursor; ++cursor)
+		if ((unsigned char)*cursor >= 0x80)
+			fatal("seed file name must be ASCII");
+	size = strtoull(separator + 1, &end, 0);
+	if (end == separator + 1 || *end || !size)
+		fatal("invalid seed file size");
+	param->seed_name = string;
+	param->seed_size = size;
+}
+
